# Copie este arquivo para .env.local e ajuste. Depois reinicie com: npx expo start --clear

# Endereço da API (Spring Boot, porta 8082)
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8082

# Endereço do site (ayvy-react, porta 5173). Opcional: se omitido, usa o mesmo host da API com a porta 5173.
EXPO_PUBLIC_WEB_URL=http://192.168.1.100:5173

# Envia os itens do carrinho do app para o carrinho do site. Só ligue (true) depois que o time do front
# implementar a importação em /carrinho?itens=... (veja a explicação enviada ao time do front).
EXPO_PUBLIC_CART_HANDOFF=false
