          }
        }
      ]
    },
    {
      "name": "Clientes",
      "description": "Passo 2 do cliente: `POST` com `usuarioId` (usuario já criado com papel `cliente`).",
      "item": [
        {
          "name": "Listar clientes",
          "request": { "method": "GET", "url": "{{baseUrl}}/clientes" }
        },
        {
          "name": "Buscar cliente por ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/clientes/{{clienteId}}" }
        },
        {
          "name": "Criar cliente (usuarioId)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuarioId\": {{usuarioId}},\n  \"cpf\": \"52998224725\",\n  \"dataNascimento\": \"1995-06-20\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/clientes",
            "description": "Antes: POST /usuarios com papel `cliente`. Use o id retornado em usuarioId."
          }
        },
        {
          "name": "Atualizar cliente",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cpf\": \"52998224725\",\n  \"dataNascimento\": \"1995-07-01\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/clientes/{{clienteId}}"
          }
        },
        {
          "name": "Deletar cliente",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/clientes/{{clienteId}}" }
        }
      ]
    },
    {
      "name": "Lojistas",
      "description": "Com imagens: use a pasta **Fluxo — Lojista com imagens**. `bannerUrl`/`logoUrl` = campo `caminho` do POST /upload (ex.: `/uploads/lojistas/abc.jpg`). Opcionais: omita ou null se não tiver imagem.",
      "item": [
        {
          "name": "Listar lojistas",
          "request": { "method": "GET", "url": "{{baseUrl}}/lojistas" }
        },
        {
          "name": "Buscar lojista por ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/lojistas/{{lojistaId}}" }
        },
        {
          "name": "Criar lojista (usuarioId)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuarioId\": {{usuarioId}},\n  \"nomeLoja\": \"ITB Moda\",\n  \"slug\": \"itb-moda\",\n  \"cnpj\": \"12345678000199\",\n  \"bannerUrl\": \"{{bannerCaminho}}\",\n  \"logoUrl\": \"{{logoCaminho}}\",\n  \"descricao\": \"Loja de moda\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/lojistas",
            "description": "bannerUrl/logoUrl: caminho local do upload, ex. /uploads/lojistas/uuid.jpg. Ver imagem: http://localhost:8082 + caminho."
          }
        },
        {
          "name": "Atualizar lojista",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomeLoja\": \"ITB Moda Atualizada\",\n  \"slug\": \"itb-moda\",\n  \"cnpj\": \"12345678000199\",\n  \"status\": \"aprovado\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/lojistas/{{lojistaId}}"
          }
        },
        {
          "name": "Deletar lojista",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/lojistas/{{lojistaId}}" }
        }
      ]
    },
    {
      "name": "Produtos",
      "description": "1) Upload em pasta `produtos` 2) POST produto com `imagemPrincipalUrl` ou `caminho` = caminho retornado 3) Galeria: POST /produtos/{id}/imagens",
      "item": [
        {
          "name": "Listar produtos",
          "request": { "method": "GET", "url": "{{baseUrl}}/produtos" }
        },
        {
          "name": "Buscar produto por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/produtos/{{produtoId}}",
            "description": "Incrementa contador de visualizações no banco."
          }
        },
        {
          "name": "Criar produto",
          "request": {
